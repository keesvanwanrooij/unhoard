# Normalise line endings: text is stored with LF in the repository.
* text=auto eol=lf

# Windows-only scripts keep CRLF in the working tree.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Lockfiles: no textual diff noise, never merged by hand.
Cargo.lock        -diff linguist-generated
package-lock.json -diff linguist-generated

# Binary files.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.webp binary
*.woff binary
*.woff2 binary
*.exe  binary
*.dll  binary
*.msi  binary
