# Shared editor settings, so every contributor formats files the same way.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
max_line_length = 90

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_size = 4
